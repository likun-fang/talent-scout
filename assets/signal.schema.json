{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "talent-scout signal",
  "type": "object",
  "required": [
    "kind",
    "name_raw",
    "channel",
    "signal_type",
    "evidence_url",
    "hop_depth"
  ],
  "properties": {
    "author_position": {"enum": ["first", "middle", "last", "unknown", ""], "description": "Position in the complete original author list, never the filtered regional list."},
    "kind": {
      "enum": [
        "person",
        "org",
        "work",
        "team",
        "company"
      ]
    },
    "name_raw": {
      "type": "string"
    },
    "affiliation_raw": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "role": {
      "enum": [
        "first_author",
        "last_author",
        "coauthor",
        "pi",
        "team_member",
        "founder",
        "maintainer",
        "inventor",
        "unknown"
      ]
    },
    "channel": {
      "type": "string"
    },
    "signal_type": {
      "type": "string",
      "examples": [
        "national_project",
        "national_fellowship",
        "resource_allocation",
        "dfg_project",
        "dfg_emmy_noether",
        "dfg_heisenberg",
        "snsf_project",
        "snsf_starting_grant",
        "snsf_ambizione",
        "snsf_professorship",
        "dfg_walter_benjamin",
        "snsf_postdoc_mobility",
        "snsf_doc_ch",
        "snsf_doc_mobility",
        "graduiertenkolleg_member",
        "imprs_member"
      ],
      "description": "Open vocabulary; erc_, dfg_, snsf_, fwf_, swecris_, rcn_, dff_, fris_ and aei_ funding signals require role pi. Optional national_project/national_fellowship signals require evidence for role pi and do not trigger funding-role inference. resource_allocation records compute/in-kind support and is excluded from research-grant aggregation and funding-role inference. Membership signals use graduiertenkolleg_member or imprs_member."
    },
    "strength": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "date": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string",
      "format": "uri"
    },
    "snippet": {
      "type": "string"
    },
    "ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hop_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "parent": {
      "type": "string",
      "description": "name_raw of the signal this was hopped from"
    },
    "note": {
      "type": "string",
      "description": "caveat about this signal (affiliation at award time, alumni list, image-only source...)"
    },
    "fit": {
      "enum": [
        "core",
        "adjacent"
      ],
      "description": "core = the work is the domain itself; adjacent = general robotics / neighbouring field (broad RoboCup leagues, exoskeletons, electronics-side PE7)"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "public lab or personal page naming the person, when the source gives one"
    },
    "role_title": {
      "type": "string",
      "description": "Verbatim title or section heading associated with this name on the source page."
    },
    "publication": {
      "type": "object",
      "description": "Paper evidence for the named person; date is first publication/public posting, not award, crawl or revision date. Authorship is verified by the researcher from the cited author list.",
      "required": ["title", "date", "status", "url", "author_name", "authorship_verified", "authorship_evidence_url"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "abstract": {"type": "string"},
        "date": {"type": "string", "pattern": "^[0-9]{4}(-[0-9]{2})?(-[0-9]{2})?$"},
        "status": {"enum": ["published", "preprint"]},
        "url": {"type": "string", "format": "uri"},
        "author_name": {"type": "string"},
        "author_ids": {"type": "object", "additionalProperties": {"type": "string"}},
        "authorship_verified": {"type": "boolean"},
        "authorship_evidence_url": {"type": "string", "format": "uri"}
      }
    },
    "topic_evidence": {
      "type": "array",
      "description": "Reviewed mappings to RUN_DIR/topic-policy.json. A contribution quote must occur in the signal source; professor topic quotes must occur in the publication title or abstract, not just a lab page.",
      "items": {
        "type": "object",
        "required": ["topic_id", "quote", "relation"],
        "properties": {
          "topic_id": {"type": "string"},
          "quote": {"type": "string", "minLength": 8},
          "relation": {"enum": ["contribution", "background"]}
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "1–3 phrases copied verbatim from a paper title, project name or repository name."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signal_type": {
            "pattern": "^(erc_|dfg_|snsf_|fwf_|swecris_|rcn_|dff_|fris_|aei_)"
          }
        },
        "required": [
          "signal_type"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "pi"
          }
        },
        "required": [
          "role"
        ]
      }
    }
  ]
}
