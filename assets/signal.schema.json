{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "talent-scout signal",
  "type": "object",
  "required": [
    "kind",
    "name_raw",
    "channel",
    "signal_type",
    "evidence_url",
    "hop_depth"
  ],
  "properties": {
    "kind": {
      "enum": [
        "person",
        "org",
        "work",
        "team",
        "company"
      ]
    },
    "name_raw": {
      "type": "string"
    },
    "affiliation_raw": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "role": {
      "enum": [
        "first_author",
        "last_author",
        "coauthor",
        "pi",
        "team_member",
        "founder",
        "maintainer",
        "inventor",
        "unknown"
      ]
    },
    "channel": {
      "type": "string"
    },
    "signal_type": {
      "type": "string",
      "examples": [
        "dfg_project",
        "dfg_emmy_noether",
        "dfg_heisenberg",
        "snsf_project",
        "snsf_starting_grant",
        "snsf_ambizione",
        "snsf_professorship",
        "graduiertenkolleg_member",
        "imprs_member"
      ],
      "description": "Open vocabulary; funding PI signals use erc_, dfg_ or snsf_ prefixes and role pi. Membership signals use graduiertenkolleg_member or imprs_member."
    },
    "strength": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "date": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string",
      "format": "uri"
    },
    "snippet": {
      "type": "string"
    },
    "ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "hop_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "parent": {
      "type": "string",
      "description": "name_raw of the signal this was hopped from"
    },
    "note": {
      "type": "string",
      "description": "caveat about this signal (affiliation at award time, alumni list, image-only source...)"
    },
    "fit": {
      "enum": [
        "core",
        "adjacent"
      ],
      "description": "core = the work is the domain itself; adjacent = general robotics / neighbouring field (broad RoboCup leagues, exoskeletons, electronics-side PE7)"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "public lab or personal page naming the person, when the source gives one"
    },
    "role_title": {
      "type": "string",
      "description": "Verbatim title or section heading associated with this name on the source page."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "1–3 phrases copied verbatim from a paper title, project name or repository name."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signal_type": {
            "pattern": "^(erc_|dfg_|snsf_)"
          }
        },
        "required": [
          "signal_type"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "pi"
          }
        },
        "required": [
          "role"
        ]
      }
    }
  ]
}
