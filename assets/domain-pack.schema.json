{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "domain pack",
  "description": "The shape of domain-cache/<slug>.yaml. A pack is this file plus assets/facets/<slug>.json and assets/known-groups/<slug>.json; scripts/check_domain_pack.py validates all three. Every key is required so that every pack has one shape; a key a field does not use stays empty. The template (assets/domain-map.template.yaml) may leave slug and derived_on blank.",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "slug", "derived_on", "window", "sources_used", "region_core", "region_extended", "facets_file",
               "scope", "directions", "discovery_seeds", "collection_requirements", "openalex_topics",
               "topic_discovery_queries", "venues", "panels_to_sweep", "euroscivoc_paths", "register_subject_filters",
               "competitions", "labs", "companies", "open_source_anchors", "keywords", "keyword_rules", "prizes_filter",
               "historical_snapshot", "quirks"],
  "$defs": {
    "list": {"type": "array", "items": {"type": ["string", "object"]}},
    "objects": {"type": "array", "items": {"type": "object"}},
    "strings": {"type": "array", "items": {"type": "string"}}
  },
  "properties": {
    "domain": {"type": "string", "description": "The field in the user's words, with its sub-directions"},
    "slug": {"type": "string", "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$", "description": "kebab-case; the file name"},
    "derived_on": {"type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$", "description": "Day the map was derived"},
    "window": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
               "properties": {"from": {"type": ["string", "null"]}, "to": {"type": ["string", "null"]}},
               "description": "Publication window the counts were computed over; null means the run's own window"},
    "sources_used": {"$ref": "#/$defs/list", "description": "Sources the map was derived from, and leads dropped"},
    "region_core": {"type": "string"},
    "region_extended": {"type": "string"},
    "facets_file": {"type": "string", "description": "assets/facets/<slug>.json, relative to SKILL_ROOT"},
    "scope": {"type": "object", "description": "core / conditional / excluded scope sentences",
              "properties": {"core": {"$ref": "#/$defs/strings"}, "conditional": {"$ref": "#/$defs/strings"},
                             "excluded": {"$ref": "#/$defs/strings"}}, "additionalProperties": false},
    "directions": {"type": "array", "items": {"type": "object", "required": ["id"]},
                   "description": "Research directions with their queries and inclusion rules"},
    "discovery_seeds": {"$ref": "#/$defs/objects", "description": "Benchmarks or lists that lead to models and groups, not people"},
    "collection_requirements": {"$ref": "#/$defs/strings"},
    "openalex_topics": {"type": "array", "items": {"type": "object", "required": ["id", "name", "fit"],
                                                   "properties": {"fit": {"enum": ["core", "adjacent"]}}}},
    "topic_discovery_queries": {"$ref": "#/$defs/strings"},
    "venues": {"type": "object", "required": ["conferences", "journals"],
               "properties": {"conferences": {"$ref": "#/$defs/list"}, "journals": {"$ref": "#/$defs/list"}}},
    "panels_to_sweep": {"$ref": "#/$defs/list"},
    "euroscivoc_paths": {"$ref": "#/$defs/list"},
    "register_subject_filters": {"type": "object", "required": ["dfg_review_boards", "snsf_main_disciplines"],
                                 "properties": {"dfg_review_boards": {"$ref": "#/$defs/list"},
                                                "snsf_main_disciplines": {"$ref": "#/$defs/list"}}},
    "competitions": {"$ref": "#/$defs/list"},
    "labs": {"$ref": "#/$defs/list", "description": "Institutions and labs, never people"},
    "companies": {"$ref": "#/$defs/list"},
    "open_source_anchors": {"$ref": "#/$defs/list"},
    "keywords": {"$ref": "#/$defs/strings"},
    "keyword_rules": {"type": "string", "description": "When a keyword alone is too broad, the filter it needs"},
    "prizes_filter": {"type": "string"},
    "historical_snapshot": {"type": "object", "description": "An earlier derivation kept for comparison"},
    "quirks": {"type": "object", "additionalProperties": false, "required": ["title_words", "institution_patterns", "evidence_venues"],
               "description": "Field-specific rules the scripts hold in code today, written down so a new field changes the pack, not the scripts",
               "properties": {
                 "title_words": {"$ref": "#/$defs/objects", "description": "{pattern, role_class, reason}: titles the role table reads for this field"},
                 "institution_patterns": {"$ref": "#/$defs/objects", "description": "{pattern, kind, reason}: employer names the role rules treat in a special way"},
                 "evidence_venues": {"$ref": "#/$defs/objects", "description": "{name, evidence, reason}: venues whose awards or lists count as evidence"}}}
  }
}
